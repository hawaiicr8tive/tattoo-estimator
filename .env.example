# Tattoolicious Price Estimator — environment variables
# Copy this file to .env.local and fill in real values.

# ─────────────────────────────────────────────────────────────────────────
# Supabase (required for everything except the public homepage at /)
# Service role key bypasses RLS — keep server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Admin (required for /admin)
# Used to derive the HMAC session cookie. Pick a long random string.
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Resend — verification + studio notification email
# Required for /api/send-verification-code and lead submission.
RESEND_API_KEY=

# Optional: where new lead notifications go if no studio email is configured
# in /admin → Leads. Falls back to a hard-coded default if unset.
STUDIO_EMAIL=

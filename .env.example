# Style Prediction Model — environment variables
# Copy this file to .env.local and fill in real values.

# ─────────────────────────────────────────────────────────────────────────
# Supabase (required — same project as the price estimator can be reused;
# the apps use different admin_config keys so they don't collide)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Admin password — the built-in "owner" account. Sign in with a blank email
# and this password. The owner is not stored in the database and can't be
# deleted or disabled, so it's always a way back in if every per-user account
# gets locked out. Everyone else gets their own login under Controls → Users.
# This is a separate credential from the price-estimator admin password
# so you can give different people access to each.
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Session cookie signing secret (optional). Defaults to ADMIN_PASSWORD.
# Set this to a separate random string if you want to rotate the owner
# password without signing every user out.
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Anthropic — required for AI Research (strand suggestions) and Fusion Lab
# deep research. Same key as the estimator's if you want to share, or a
# dedicated one with separate billing.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Google Gemini — required for the Fusion Lab "Generate flash designs"
# button. Uses Nano Banana 2 (gemini-3.1-flash-image-preview). ~$0.07/image.
GEMINI_API_KEY=
